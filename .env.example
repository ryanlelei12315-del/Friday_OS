# ============================================================================
# FRIDAY OS - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ============================================================================

# LiveKit Configuration (REQUIRED)
# Get these from https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API_xxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API (REQUIRED)
# Get API key from https://ai.google.dev/
GOOGLE_API_KEY=AIzaSy...

# Groq API (REQUIRED)
# Get API key from https://console.groq.com/
GROQ_API_KEY=gsk_...

# Gmail SMTP Configuration (OPTIONAL)
# Required only for email tool functionality
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Home Assistant Configuration (OPTIONAL)
# Required only for smart home device control
HOME_ASSISTANT_URL=http://192.168.1.100:8123
HOME_ASSISTANT_TOKEN=eyJ...

# PostgreSQL Configuration (REQUIRED)
# For memory persistence and vector storage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=friday_memory
POSTGRES_USER=friday
POSTGRES_PASSWORD=your_secure_password_here
